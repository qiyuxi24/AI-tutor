# ════════════════════════════════════════════
# AI 编程助手 / 自动化工具产物
# .codebuddy 与 .workbuddy 的工作记忆、Agent 配置全队共享；
# 仅排除第三方插件、本机配置与个人日志
# ════════════════════════════════════════════
.playwright-cli/
# Playwright 页面快照（根目录临时文件）
/init.yaml
/login.yaml
# 第三方插件库（ponytail 等，成员按需自行安装）
.codebuddy/skills/
# 本机插件配置
.codebuddy/settings.local.json
# 个人求职日志（与项目无关，勿提交）
.workbuddy/memory/2026-09-01.md

# ════════════════════════════════════════════
# 运行时数据 / 生成文件
# ════════════════════════════════════════════
# 备份文件
*.bak
# SQLite 运行时文件（WAL / 共享内存）
*.db-shm
*.db-wal
# Whoosh 检索索引（可由知识库重建）
whoosh_index/
# 后端运行时数据（知识库索引、测验库等，可重建）
backend/data/

