# ════════════════════════════════════════════════════════════
#  演示模式（本文件存在即生效；删除 + reload 即恢复门口口令）
#  开关：/root/tutor-demo.sh on | off | status
#  说明：deploy/tutor-demo/README.md
# ════════════════════════════════════════════════════════════
set $tutor_demo 1;

# ── 1) 关闭公开注册：演示期只允许已有账号登录 ──
location = /api/v1/auth/register {
    default_type application/json;
    return 403 '{"detail":"演示期间已关闭注册，请使用演示账号登录"}';
}

# ── 2) 实时通道 = 在线页面上限：每个页面恰好 1 条 SSE，关标签即释放 ──
location = /api/v1/knowledge/events {
    limit_conn tutor_seat 3;
    limit_conn_status 429;

    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# ── 3) 对话流并发上限 3：第 4 个同时提问被挡，保护 LLM 额度 ──
location = /api/v1/chat/stream {
    limit_conn tutor_chat 3;
    limit_conn_status 429;

    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
