# ═══════════════════════════════════════════════════════════════
#  AI Tutor Docker 部署配置模板（根目录）
#  用法：复制本文件为根目录 .env，填入真实值后执行 docker compose up -d --build
#  注意：这是 Docker 部署专用配置；本地开发配置在 backend/.env，两者互不干扰。
#  compose 会自动读取根目录 .env 做变量替换并注入容器环境变量。
# ═══════════════════════════════════════════════════════════════

# ─── LLM 服务 ───
# 阿里云百炼 API Key（必填）
DASHSCOPE_API_KEY=

# LLM 模型名称（默认 qwen-plus）
# MODEL_NAME=qwen-plus

# LLM API Base URL（默认阿里云 OpenAI 兼容地址）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─── 认证 / JWT ───
# JWT 签名密钥（必填，服务拒绝启动；请用 openssl rand -hex 32 生成强随机串）
SECRET_KEY=

# ─── 部署端口 / 域名 ───
# 宿主机映射端口（默认 8080；若服务器 80 空闲可改为 80）
# PORT=8080

# CORS 白名单（同源部署不需要；如需要直连后端 8000 端口再放开）
# CORS_ALLOW_ORIGINS=http://localhost,http://你的域名

# ─── 管理员账户 ───
# 设置后首次启动自动创建 admin 账户（默认密码）
# DEFAULT_ADMIN_PASSWORD=admin123
