# ═══════════════════════════════════════════════════════════════
#  TutorAgent 环境配置模板
#  用法：复制本文件为根目录 .env 并按需修改
#  ⚠️ 根目录 .env 是唯一真值文件：本地 uvicorn 与 docker compose 共用
#  变量读取入口：backend/app/core/config.py（字段与此一一对应）
# ═══════════════════════════════════════════════════════════════

# ─── 对话 / Agent 主模型（OpenAI 兼容）───
# MiniMax Key（必填；platform.minimaxi.com → 控制台 → API Keys 创建）
LLM_API_KEY=

# MiniMax 国内站 OpenAI 兼容端点（国际站账号改 https://api.minimax.io/v1）
LLM_BASE_URL=https://api.minimaxi.com/v1

# 模型：最新 MiniMax-M3（1M 上下文 / 多模态）；备选 MiniMax-M2.7 / MiniMax-M2.5
# 想切回阿里云 qwen：LLM_BASE_URL 改 https://dashscope.aliyuncs.com/compatible-mode/v1，
# 且 LLM_API_KEY 留空（自动回退用 DASHSCOPE_API_KEY）
MODEL_NAME=MiniMax-M3

# ─── 备用对话服务（可选，模型回退链，2026-09-08）───
# 主模型额度耗尽(402/403)/认证失效/持续异常时，自动静默降级到备用服务重发同一请求，
# 教学对话不中断（只记日志，前端无感知）。三件套缺任一即不启用（=单模型旧行为）。
# ⚠️ 记得：这一层是"保底"，备用服务应选与主模型不同供应商的独立账号/Key，才有真实冗余。
# 示例（阿里 qwen 作备用）：BASE 填 https://dashscope.aliyuncs.com/compatible-mode/v1，
# MODEL 填 qwen-plus，KEY 填阿里百炼 Key（留空自动回退 DASHSCOPE_API_KEY）
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_BASE_URL=
# FALLBACK_MODEL_NAME=

# ─── 嵌入服务（text-embedding-v4 固定阿里云，独立于对话模型）───
DASHSCOPE_API_KEY=

# 嵌入端点（默认阿里云，通常无需修改）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─── 认证 / JWT ───
# JWT 签名密钥（必填，服务拒绝启动；用 openssl rand -hex 32 生成）
SECRET_KEY=

# ─── 部署 / CORS ───
# 宿主机映射端口（Docker 部署用，默认 8080）
# PORT=8080
# CORS 白名单（同源部署不需要；直连后端 8000 才需要放开）
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── 管理员账户 ───
# 设置后首次启动自动创建 admin 账户（默认密码）
# DEFAULT_ADMIN_PASSWORD=admin123

# ─── 网页搜索（Agent 工具 web_search，2026-09-12）───
# 内置 MCP server（app/mcp_servers/web_search.py）经 in-memory 协议提供联网搜索，
# 默认后端 ddgs（MIT，无需 API key）。设 false 即整体关闭，工具表回到原生 8 个。
# WEB_SEARCH_ENABLED=true
# 自建 SearXNG 实例地址（可选；需在其 settings.yml 的 search.formats 加 json）；
# 配了就优先用它，留空则用 ddgs
# SEARXNG_URL=http://localhost:8888

# ─── 上下文预算（2026-09-13）───
# 单轮发送预算（tokens，含 system_prompt）：超出自动丢掉最旧对话轮次
# LLM_CTX_BUDGET=32000
# 图谱注入 system prompt 的字符上限（≈8K token，0=不限制）：超出按
# 「省节点摘要 → 限量节点」降级，并在注入文本里标注展示范围。
# ⚠️ 图谱涨到 100+ 节点时不要调大 —— 那正是每轮输入成本线性增长的来源
# GRAPH_INJECT_MAX_CHARS=12000

# ─── 可选 ───
# LLM_TIMEOUT=120
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
