# ═══════════════════════════════════════════════════════════════
#  AI Tutor 后端环境变量配置
#  统一由 backend/app/core/config.py 读取（字段名与此一一对应）
#  复制本文件为 .env 并按需修改
# ═══════════════════════════════════════════════════════════════

# ─── LLM 服务 ───
# 阿里云百炼 API Key（必填）
DASHSCOPE_API_KEY=your_api_key_here

# LLM 模型名称（默认 qwen-plus）
MODEL_NAME=qwen-plus

# LLM API Base URL（默认阿里云 OpenAI 兼容地址，可改为其他兼容服务）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM 请求超时（秒，默认 120）
# LLM_TIMEOUT=120

# ─── 认证 / JWT ───
# JWT 签名密钥（必填，服务拒绝启动；请生成强随机串替换）
SECRET_KEY=change_me_to_a_random_secret

# JWT 签名算法（默认 HS256）
# JWT_ALGORITHM=HS256
# Access Token 有效期（分钟，默认 1440 = 24 小时）
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS 跨域 ───
# 白名单（逗号分隔多个来源，默认仅本地前端）
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 允许的方法 / 请求头（默认全部 *）
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*

# ─── 启动 / 管理员 ───
# 管理员默认密码（可选，设置后首次启动自动创建 admin 账户）
# DEFAULT_ADMIN_PASSWORD=admin123
